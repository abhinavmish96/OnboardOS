# Terse Durable Actors
DURABLE_ACTORS_CONTROL_PLANE_URL=http://127.0.0.1:7100

# Agent Relay (local)
# Run `agent-relay init --tools none --port 8787` to generate these
RELAY_URL=http://127.0.0.1:8787
RELAY_WORKSPACE_KEY=<from ~/.agentworkforce/relay/workspaces.json>

# Agent tokens — run these to generate:
#   agent-relay agent register finance_agent
#   agent-relay agent register document_agent
#   agent-relay agent register compliance_agent
# Tokens are saved to ~/.agentworkforce/relay/agent-tokens.json
# The backend reads them automatically from that file.
